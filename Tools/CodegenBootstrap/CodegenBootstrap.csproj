<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless host for the project's Unity-side template code generator.

    Compiles the REAL generator source files (GenUtils.cs, TemplateConverter.cs) straight out of
    Assets/LinearAlgebra/CodeGen/ - never copy/duplicate them here, that would let the headless
    and Unity code paths drift. The only new code in this project is Program.cs (drives the
    converter the same way the two [Generator] wrappers do, then replicates UnityCodeGen's
    ScriptFileGenerator.GenerateScriptFromContext write logic) and small stub types under Stubs/
    standing in for the UnityEngine.Debug / UnityCodeGen.GeneratorContext surface that
    TemplateConverter.cs references.

    See Tools/regen.ps1 for how this gets invoked.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CodegenBootstrap</RootNamespace>
    <AssemblyName>CodegenBootstrap</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real generator source, compiled in place - zero drift with the Unity-side codegen. -->
    <Compile Include="..\..\Assets\LinearAlgebra\CodeGen\GenUtils.cs" Link="RealSource\GenUtils.cs" />
    <Compile Include="..\..\Assets\LinearAlgebra\CodeGen\TemplateConverter.cs" Link="RealSource\TemplateConverter.cs" />
  </ItemGroup>

</Project>
